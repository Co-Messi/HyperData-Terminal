# HyperData Terminal: environment configuration
# Copy this file to .env (in the directory you run from, or in the data
# directory) and fill in the values you need. The real environment always wins.
#
# Marked [protected] below: read only from the environment or from the .env in
# the data directory, never from a .env in the working directory, so a cloned
# repository cannot expose the API or redirect your LLM key.

# ── LLM Trading Agent ─────────────────────────────────────
# Any OpenAI-compatible API works: OpenAI, Ollama, LM Studio, Groq, Together, etc.
# For Ollama (local): LLM_BASE_URL=http://localhost:11434/v1
# For OpenAI:         LLM_BASE_URL=https://api.openai.com/v1
# [protected] The key is sent only over https or to localhost/127.0.0.1/::1.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-...

# ── Liquidation cascade alerts (optional) ────────────────
# One alert type exists: a liquidation cascade. While any hyperdata command
# runs, one message goes to every configured channel when CONFIRMED
# liquidations (Binance, Bybit, OKX, HLP absorbed Hyperliquid ones; never
# Hyperliquid large prints) across all symbols reach:
#   $10M within 5 minutes (at most one message every 15 minutes), or
#   $50M within 1 hour    (at most one message every 60 minutes).
# Check the setup with: hyperdata alerts --test
#
# Telegram: message @BotFather, send /newbot, copy the token; the chat id is
# your user or group id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: create a webhook in channel settings
DISCORD_WEBHOOK_URL=

# Thresholds in USD (optional)
HYPERDATA_ALERT_CASCADE_5M_USD=10000000
HYPERDATA_ALERT_CASCADE_1H_USD=50000000

# ── REST API exposure (see README "REST API" security note) ─────
# [protected] every setting in this block.
# Loopback (127.0.0.1) needs no key. A non-loopback bind is refused unless
# HYPERDATA_API_KEY is set (auth required on all non-health routes) or
# HYPERDATA_UNSAFE_PUBLIC_API=1 explicitly accepts unauthenticated exposure.
# Browsers get NO cross-origin access on any bind unless the page's origin is
# listed in HYPERDATA_CORS_ORIGINS (comma-separated); the same list gates
# WebSocket upgrades. curl/SDK clients are unaffected.
HYPERDATA_API_HOST=127.0.0.1
HYPERDATA_API_KEY=
HYPERDATA_CORS_ORIGINS=
HYPERDATA_UNSAFE_PUBLIC_API=

# ── Storage ───────────────────────────────────────────────
# Store raw trades (1 in 2) in the SQLite file. Off by default: nothing reads
# them back and they grow the file by millions of rows a week.
HYPERDATA_PERSIST_TRADES=

# ── LLM cost guardrail ────────────────────────────────────
# Max LLM strategy evaluations per hour (default 60).
LLM_MAX_EVALS_PER_HOUR=60
